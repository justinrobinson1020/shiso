# Copy to /etc/shiso/shiso.env on the LXC (mode 600, owner shiso:shiso).
# deploy/install.sh does this automatically on first install if the file
# is missing. Never commit the filled-in version.

SHISO_DB_PATH=/opt/shiso/data/shiso.db
SHISO_BACKUP_DIR=/opt/shiso/backups

# Generate with: openssl rand -base64 48
SHISO_APP_KEY=

SHISO_TZ=America/New_York

# Budget period cadence: semi_monthly (1st-15th, 16th-end) or monthly.
SHISO_CADENCE=semi_monthly

# Local hour (0-23) for the nightly transaction sync.
SHISO_SYNC_HOUR=3
# Local hour (0-23) for the daily balance refresh.
SHISO_BALANCE_HOUR=7

# Where drizzle/ lives. The release tarball ships it beside build/.
SHISO_MIGRATIONS_DIR=/opt/shiso/current/drizzle

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production

# Scheduler: set to off to disable the nightly and morning sync jobs.
SHISO_SCHEDULER=on

# Shown by Plaid Link as the app name.
SHISO_PLAID_CLIENT_NAME=shiso

# Local hour (0-23) for the nightly VACUUM INTO backup, and how many
# dated backups to keep.
SHISO_BACKUP_HOUR=4
SHISO_BACKUP_KEEP=30

# adapter-node needs ORIGIN for form posts behind Caddy's reverse proxy.
ORIGIN=http://shiso.home.local

# PORT and HOST are set directly in deploy/shiso.service, not here.
